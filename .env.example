# Sendio Environment Variables
# Copy this file to .env and fill in your values

# ========== REQUIRED ==========

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/sendio

# Salt for hashing API keys (min 32 chars)
# Generate with: openssl rand -hex 32
API_KEY_SALT=

# Secret for signing session tokens (min 32 chars)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM encryption key (EXACTLY 32 characters)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=

# ========== OPTIONAL ==========

# Server port (default: 8080)
PORT=8080

# Environment (default: development)
APP_ENV=development

# Public server URL for OAuth callbacks
PUBLIC_SERVER_URL=http://localhost:8080

# Frontend URL
WEB_URL=http://localhost:5173

# Database connection pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis connection (default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Default SMTP relay
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ========== OAUTH ==========

# Google OAuth (optional — enables Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — enables GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========== LOGGING ==========

# Log file directory
LOG_PATH=log/